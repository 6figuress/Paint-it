Bootstrap: docker
From: nvidia/cuda:11.8.0-base-ubuntu22.04
%help
    This container provides a CUDA environment, with Python.
%labels
    AUTHOR_NAME Dion Osmani
    VERSION 1.0
%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"
    export LD_LIBRARY_PATH="/usr/local/cuda-11.8/lib64:${VIRTUAL_ENV}/lib/python3.10/site-packages/torch/lib:${LD_LIBRARY_PATH}"
%files
    requirements.txt /opt/requirements.txt
%post -c /bin/bash
    # Set up environment variables
    export DEBIAN_FRONTEND=noninteractive
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"

    # Create working directory
    mkdir -p /opt/app

    # System updates and dependencies
    apt-get -y update
    apt-get -y install \
        git \
        python3-pip \
        python3-dev \
        python3-venv \
        libglib2.0-0 \
        cuda-toolkit-11-8 \
        cuda-libraries-dev-11-8 \
        cuda-runtime-11-8 \
        build-essential \
        ninja-build \
        cmake

    # Create and activate virtual environment
    python3 -m venv $VIRTUAL_ENV
    source $VIRTUAL_ENV/bin/activate

    # Install Python packages in the virtual environment
    python3 -m pip install --upgrade pip


    # Install PyTorch in the virtual environment
    python3 -m pip install requests
    python3 -m pip install torch==2.1.0+cu118 --index-url https://download.pytorch.org/whl/cu118
    python3 -m pip install torchaudio==2.1.0+cu118 --no-deps --index-url https://download.pytorch.org/whl/cu118
    python3 -m pip install torchvision==0.16.0+cu118 --no-deps --index-url https://download.pytorch.org/whl/cu118


    # Install dependencies for PyTorch3D
    pip3 install fvcore iopath

    # Install PyTorch3D from prebuilt wheels
    pip3 install --no-index --no-cache-dir pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py310_cu118_pyt210/pytorch3d-0.7.5-cp310-cp310-linux_x86_64.whl

    # Install NVDiffrast
    pip3 install git+https://github.com/NVlabs/nvdiffrast/

    # Install other requirements
    pip3 install --no-deps -r /opt/requirements.txt

    # Clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*
