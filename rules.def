Bootstrap: docker
From: nvidia/cuda:11.8.0-base-ubuntu22.04

%help
    This container provides a CUDA environment, with Python.

%labels
    AUTHOR_NAME Dion Osmani
    VERSION 1.0

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"

%files
    requirements.txt /opt/requirements.txt

%post -c /bin/bash
    # Set up environment variables
    export DEBIAN_FRONTEND=noninteractive
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"

    # Create working directory
    mkdir -p /opt/app

    # System updates and dependencies
    apt-get -y update
    apt-get -y install \
        git \
        python3-pip \
        python3-dev \
        python3-venv \
        libglib2.0-0 \
        cuda-toolkit-11-8

    # Create and activate virtual environment
    python3 -m venv $VIRTUAL_ENV

    # Install Python packages
    python3 -m pip install --upgrade pip
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118
    pip3 install fvcore
    pip3 install --no-index --no-cache-dir pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py310_cu113_pyt1120/pytorch3d-0.7.2-cp310-cp310-linux_x86_64.whl
    pip3 install git+https://github.com/NVlabs/nvdiffrast/
    pip3 install -r /opt/requirements.txt

    # Clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*
