Bootstrap: docker
From: nvidia/cuda:12.2.0-base-ubuntu22.04
%help
    This container provides a CUDA 12.2 environment with Python for H100 GPU support.
%labels
    AUTHOR_NAME Dion Osmani
    VERSION 2.0
%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"
    export LD_LIBRARY_PATH="/usr/local/cuda-12.2/lib64:${VIRTUAL_ENV}/lib/python3.10/site-packages/torch/lib:${LD_LIBRARY_PATH}"
%files
    requirements.txt /opt/requirements.txt
%post -c /bin/bash
    # Set up environment variables
    export DEBIAN_FRONTEND=noninteractive
    export VIRTUAL_ENV=/opt/venv
    export PATH="$VIRTUAL_ENV/bin:$PATH"
    # Create working directory
    mkdir -p /opt/app
    # System updates and dependencies
    apt-get -y update
    apt-get -y install \
        git \
        python3-pip \
        python3-dev \
        python3-venv \
        libglib2.0-0 \
        cuda-toolkit-12-2 \
        cuda-libraries-dev-12-2 \
        cuda-runtime-12-2 \
        build-essential \
        ninja-build \
        cmake
    # Create and activate virtual environment
    python3 -m venv $VIRTUAL_ENV
    source $VIRTUAL_ENV/bin/activate
    # Install Python packages in the virtual environment
    python3 -m pip install --upgrade pip
    # Install PyTorch in the virtual environment with CUDA 12.x support
    python3 -m pip install requests
    python3 -m pip install torch==2.2.0+cu121 --index-url https://download.pytorch.org/whl/cu121
    python3 -m pip install torchaudio==2.2.0+cu121 --no-deps --index-url https://download.pytorch.org/whl/cu121
    python3 -m pip install torchvision==0.17.0+cu121 --no-deps --index-url https://download.pytorch.org/whl/cu121
    # Install dependencies for PyTorch3D
    pip3 install fvcore iopath
    # Note: May need to check for updated PyTorch3D wheels compatible with PyTorch 2.2 and CUDA 12.1
    # If the below wheel doesn't exist, you may need to build from source or find an alternative
    pip3 install --no-index --no-cache-dir pytorch3d -f https://dl.fbaipublicfiles.com/pytorch3d/packaging/wheels/py310_cu121_pyt210/pytorch3d-0.7.5-cp310-cp310-linux_x86_64.whl
    # pip3 install "git+https://github.com/facebookresearch/pytorch3d.git"
    # Install NVDiffrast - this will now compile correctly for H100
    pip3 install git+https://github.com/NVlabs/nvdiffrast/
    # Set architecture flags to explicitly include H100 support
    export TORCH_CUDA_ARCH_LIST="9.0;8.9;8.6"
    # Install other requirements
    pip3 install --no-deps -r /opt/requirements.txt
    # Clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*
