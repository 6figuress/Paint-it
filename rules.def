Bootstrap: docker
From: nvidia/cuda:12.6.2-base-ubuntu22.04

%help
  This container provides a CUDA environment, with Python.

%labels
  AUTHOR_NAME Dion Osmani
  VERSION 1.0

%environment

%post -c /bin/bash
  export DEBIAN_FRONTEND=noninteractive
  apt-get -y update
  apt-get -y install git python3-pip python3-dev libglib2.0-0

%files
  requirements.txt requirements.txt

%post -c /bin/bash
  python3 -m venv .venv
  source .venv/bin/activate
  pip install torch==1.12.0+cu113 torchaudio==0.12.0+cu113 torchvision==0.13.0+cu113 --extra-index-url https://download.pytorch.org/whl/cu113
  python3 -m pip install --upgrade pip
  pip3 install -r requirements.txt
